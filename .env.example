# Скопируйте в .env и заполните. РЕАЛЬНЫЕ значения не коммитить.
# На HostPro переменные задаются в панели окружения — локальный .env не обязателен.
# У всех переменных есть безопасные значения по умолчанию в коде (server/config/env.js).

NODE_ENV=
# trust proxy: пусто = выкл. Для HostPro за прокси можно указать 1 (число хопов) или true.
TRUST_PROXY=
PORT=

# Лимиты и таймауты
JSON_BODY_LIMIT=
EXTERNAL_TIMEOUT_MS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Резервное хранилище заявок (локальный файл, вне git)
LEADS_FILE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно (по умолчанию https://api.telegram.org)
# TELEGRAM_API_BASE=

# Google Apps Script Web App (третий канал доставки).
# URL — адрес развёрнутого веб-приложения, вида https://script.google.com/macros/s/.../exec
# SECRET — общий секрет, Apps Script сверяет его с приходящим в теле запроса.
# Пусто = канал выключен (заявки уходят только в Telegram/Pipedrive).
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Необязательно (по умолчанию 10000)
# GOOGLE_APPS_SCRIPT_TIMEOUT_MS=

# Pipedrive. Заявка создаёт Person → Deal (в воронке/этапе ниже) → Note.
# Пустой токен или домен = канал выключен (заявки уходят только в Telegram/Sheets).
# Личный API-токен: Pipedrive → аватар → Personal preferences → API.
PIPEDRIVE_API_TOKEN=
# Только поддомен, без https:// и без .pipedrive.com.
# Например, для https://mycompany.pipedrive.com укажите: mycompany
PIPEDRIVE_COMPANY_DOMAIN=
# Воронка и этап, куда попадает сделка (числовые ID).
# Узнать: открыть воронку в Pipedrive и посмотреть URL /pipeline/<PIPELINE_ID>/,
# либо GET /api/v1/pipelines и GET /api/v1/stages?pipeline_id=<ID> с токеном.
# Пусто = сделка уйдёт в воронку и этап по умолчанию.
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
# Ответственный за сделку (числовой ID пользователя). Пусто = владелец токена.
PIPEDRIVE_OWNER_ID=
# Метки сделки: числовые ID опций через запятую (не UUID лидов). Пусто = без меток.
PIPEDRIVE_LABEL_IDS=
# API-ключи (hash) кастомных Deal-полей под UTM (создаются в Pipedrive вручную)
PIPEDRIVE_UTM_SOURCE_FIELD_KEY=
PIPEDRIVE_UTM_MEDIUM_FIELD_KEY=
PIPEDRIVE_UTM_CAMPAIGN_FIELD_KEY=
PIPEDRIVE_UTM_CONTENT_FIELD_KEY=
PIPEDRIVE_UTM_TERM_FIELD_KEY=
# Необязательно (по умолчанию 10000 / https://{domain}.pipedrive.com)
# PIPEDRIVE_TIMEOUT_MS=
# PIPEDRIVE_API_BASE=
